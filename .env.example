# Copy to .env and adjust. All values are optional.

# true = Gradio web editor, false = terminal flow with the desktop (PySide6) editor
ENABLE_WEB_EDITOR=true

# Generate a Stable Diffusion + ControlNet render after export (requires torch + diffusers)
ENABLE_POST_DONE_RENDER=false

GRADIO_HOST=127.0.0.1
GRADIO_PORT=8001

RESPLAN_LOG_LEVEL=INFO
